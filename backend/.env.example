# Backend dev configuration: copy to backend/.env (gitignored) and adjust.
# Real environment variables always take precedence over these values.
#
# Values for deployment live in deploy/.env.example.

# Host ports published by deploy/docker-compose.dev.yml.
POSTGRES_URL=postgres://traintracks:traintracks@localhost:15432/traintracks?sslmode=disable
REDIS_URL=redis://localhost:16379/0

