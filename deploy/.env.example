# TrainTracks deployment variables (copy to .env and fill in).
# Public data feed URLs live in backend/internal/config/config.go; put them
# here ONLY if you need to override them (e.g. staging mirror).
#
# No reverse proxy or TLS is shipped: front the API and frontend with whatever
# you already run, or reach them directly on the published ports below.

# Required
POSTGRES_PASSWORD=change-me

# Optional overrides
# Host ports for published containers
# API_PORT=18080
# FRONTEND_PORT=13000
# POSTGRES_PORT=15432
# REDIS_PORT=16379
# UTA_GTFS_RT_VEHICLE_URL=https://apps.rideuta.com/tms/gtfs/Vehicle
# UTA_GTFS_RT_TRIPUPDATE_URL=https://apps.rideuta.com/tms/gtfs/TripUpdate
# UTA_GTFS_STATIC_URL=https://apps.rideuta.com/tms/gtfs/Static

# Public API tuning
RATE_LIMIT_PER_MIN=120
SSE_MAX_CONN_PER_IP=3

# Where the browser finds the API. Keep /api/v1 when a reverse proxy serves the
# frontend and the API from one origin; otherwise use the API origin, e.g.
# http://localhost:18080/api/v1.
PUBLIC_API_BASE=/api/v1

# CORS_ALLOWED_ORIGIN=*

# POSTGRES_USER=traintracks
# POSTGRES_DB=traintracks
